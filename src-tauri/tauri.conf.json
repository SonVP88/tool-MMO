{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutomationStudioPro",
  "version": "2.2.1",
  "identifier": "com.automationstudio.mmo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AUTOMATION STUDIO - TỰ ĐỘNG HÓA SẢN XUẤT HÀNG LOẠT",
        "width": 1360,
        "height": 840,
        "minWidth": 1200,
        "minHeight": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Automation Studio MMO Pro",
    "category": "Video",
    "shortDescription": "Batch Video Dubbing & Reup Automation Studio",
    "externalBin": [
      "bin/pipeline_worker"
    ],
    "resources": [
      "bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
